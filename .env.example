# ── App ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/sentinelai
SECRET_KEY=change-this-to-a-very-long-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── First admin (seeded on first startup) ─────────────────────
FIRST_ADMIN_NAME=Administrator
FIRST_ADMIN_EMAIL=admin@sentinelai.com
FIRST_ADMIN_PASSWORD=Admin@12345

# ── YOLOv11 AI Engine ─────────────────────────────────────────
MODEL_PATH=./model/best.pt
CONFIDENCE_THRESHOLD=0.50
IOU_THRESHOLD=0.45
IMAGE_SIZE=640
DEVICE=auto
FRAME_SKIP=1
VIOLATION_CONFIRMATION_FRAMES=3
INCIDENT_COOLDOWN_SECONDS=30

# ── Storage ───────────────────────────────────────────────────
UPLOAD_DIR=./storage/uploads
STORAGE_DIR=./storage
INCIDENTS_DIR=./storage/incidents

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
